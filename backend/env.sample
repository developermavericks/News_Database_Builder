# Database Configuration
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/news_scraper
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20
DB_USE_NULLPOOL=false

# Redis Configuration (Broker & Backend)
REDIS_URL=redis://127.0.0.1:6379/0

# Celery Configuration
CELERY_WORKER_CONCURRENCY=16
CELERY_WORKER_GEVENT=1

# Scraper Settings
GOOGLE_NEWS_GEO=IN
SEARCH_REGION=india
DEFAULT_DISCOVERY_LIMIT=1000000

# Proxy & Resilience
PROXY_GEO=US
MAX_PROXY_RETRIES=3
WEBSHARE_PROXY_USER=
WEBSHARE_PROXY_PASS=
WEBSHARE_PROXY_HOST=p.webshare.io
WEBSHARE_IP_AUTH=false

# API Keys
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

SECRET_KEY=nexus_local_dev_key_2026
EMERGENCY_STOP_PHRASE=FML
